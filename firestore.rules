rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile and subcollections are strictly scoped to the authenticated owner.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Meal analyses recorded with verified image vision processing
      match /mealAnalyses/{analysisId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      // User saved foods from the nutrition explorer
      match /savedFoods/{foodId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      // User bookmarks from nutrition science articles
      match /bookmarks/{bookmarkId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      // User generated diet plans
      match /dietPlans/{planId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny-all policy for any other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
